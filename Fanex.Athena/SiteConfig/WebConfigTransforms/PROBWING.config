<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <log4net>
    <appender name="GeneralLog" type="log4net.Appender.RollingFileAppender">
      <file value="E:/3.Logs/lrf/log4net.txt" xdt:Transform="Replace" />
    </appender>
  </log4net>
  <system.web>
    <compilation debug="false" xdt:Transform="SetAttributes(debug)" />
    <customErrors mode="RemoteOnly" xdt:Transform="SetAttributes(mode)" />
    <httpRuntime requestValidationMode="2.0" targetFramework="4.6.1" executionTimeout="600" xdt:Transform="Replace" />
    <authentication mode="Forms" xdt:Transform="Replace">
	  <forms cookieless="UseCookies" timeout="1400" slidingExpiration="true" loginUrl="~/Utility/LocationRestriction" path="/" defaultUrl="~/Home/Index" name="n8b_form_auth" protection="All" />
    </authentication>
    <sessionState mode="Custom" cookieName="n8b_session" customProvider="NVCAppSessionStateStore" xdt:Transform="Replace">
      <providers>
        <add name="NVCAppSessionStateStore" type="Microsoft.Web.Redis.RedisSessionStateProvider" applicationName="nvc_mpa_session" host="10.99.99.51" port="16379" databaseId="4" accessKey="foo1@bared" ssl="false" />
      </providers>
    </sessionState>
    <httpHandlers>    
      <add path="*" verb="OPTIONS" type="System.Web.DefaultHttpHandler" validate="false" xdt:Transform="Insert"/>
    </httpHandlers>
  </system.web>
  <system.net xdt:Transform="Insert">
    <defaultProxy useDefaultCredentials="true"> </defaultProxy>
  </system.net>
  <N88Settings xdt:Transform="Replace" Environment="LIVE" EnableDirectLogin="1" SiteId="4" UnauthorizeUrl="~/Home/NonePermission" EnableReCheckin="false"
    HubUrl="http://localhost:54332/NAPHub" ServiceUrls="http://10.99.99.51:7572/api" AccessKey="BVjDnoB75xbmijAyAFRW8jawVxy/rAnRlxvs2KDokoM=">
    <Domain>
      <add Name="bo.bwing.com" Path="/" />
    </Domain>
  </N88Settings>
  <BrandSetting xdt:Transform="Replace" SupportMultiBrand="false">
    <Brands>
      <add Name="N8B" Id="437" FunctionKey="N8B_Brand" />
    </Brands>
  </BrandSetting>
</configuration>