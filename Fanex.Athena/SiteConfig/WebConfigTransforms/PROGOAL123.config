<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
	<log4net>
		<appender name="GeneralLog" type="log4net.Appender.RollingFileAppender">
			<file value="E:/3.Logs/lrf/log4net.txt" xdt:Transform="Replace" />
		</appender>
	</log4net>
	<system.web>
		<compilation debug="false" xdt:Transform="SetAttributes(debug)" />
		<customErrors mode="RemoteOnly" xdt:Transform="SetAttributes(mode)" />
		<httpRuntime requestValidationMode="2.0" targetFramework="4.6.1" executionTimeout="600" xdt:Transform="Replace" />
		<sessionState mode="Custom" cookieName="n8g_session" customProvider="NVCAppSessionStateStore" xdt:Transform="Replace">
			<providers>
				<add name="NVCAppSessionStateStore" type="Microsoft.Web.Redis.RedisSessionStateProvider" applicationName="nvc_mpa_session" host="vn-nap777.gamora.prod" port="16777" databaseId="4" accessKey="foo1@bared" ssl="false" />
			</providers>
		</sessionState>
		<httpHandlers>
			<add path="*" verb="OPTIONS" type="System.Web.DefaultHttpHandler" validate="false" xdt:Transform="Insert" />
		</httpHandlers>
	</system.web>
	<system.net xdt:Transform="Insert">
		<defaultProxy useDefaultCredentials="true"> </defaultProxy>
	</system.net>
	<N88Settings xdt:Transform="Replace" Environment="LIVE" EnableDirectLogin="1" SiteId="5" UnauthorizeUrl="~/Home/NonePermission" EnableReCheckin="false"
    HubUrl="http://localhost:54332/NAPHub" ServiceUrls="http://n88-api.starix-dr.gamora.prod/api" AccessKey="e3pVrvuBKIZViUpRZdBBAAJakBg7HKV6ouh7EJEdgbA=">
		<Domain>
			<add Name="bo.goal123.com" Path="/" />
		</Domain>
	</N88Settings>
	<BrandSetting xdt:Transform="Replace" SupportMultiBrand="false">
		<Brands>
			<add Name="N8G" Id="436" FunctionKey="N8G_Brand" />
		</Brands>
	</BrandSetting>
</configuration>