<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <log4net>
    <appender name="GeneralLog" type="log4net.Appender.RollingFileAppender">
      <file value="E:/3.Logs/lrf/log4net.txt" xdt:Transform="Replace" />
    </appender>
  </log4net>
  <system.web>
    <compilation xdt:Transform="Remove" />
    <customErrors mode="Off" xdt:Transform="SetAttributes(mode)" />
    <httpRuntime requestValidationMode="2.0" targetFramework="4.6.1" executionTimeout="600" xdt:Transform="Replace" />
	  <sessionState mode="Custom" cookieName="n88_session" customProvider="NVCAppSessionStateStore" xdt:Transform="Replace">
		  <providers>
			  <add name="NVCAppSessionStateStore" type="Microsoft.Web.Redis.RedisSessionStateProvider" applicationName="nvc_mpa_session" host="172.16.4.109" port="16379" databaseId="4" accessKey="foo1@bared" ssl="false" />
		  </providers>
	  </sessionState>
    <httpHandlers>
      <add path="*" verb="OPTIONS" type="System.Web.DefaultHttpHandler" validate="false" xdt:Transform="Insert"/>
    </httpHandlers>
  </system.web>
</configuration>