<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <log4net>
    <appender name="GeneralLog" type="log4net.Appender.RollingFileAppender">
      <file value="E:/3.Logs/lrf/log4net.txt" xdt:Transform="Replace" />
    </appender>
  </log4net>
  <system.web>
    <customErrors mode="RemoteOnly" xdt:Transform="SetAttributes(mode)" />
    <httpRuntime requestValidationMode="2.0" targetFramework="4.6.1" executionTimeout="600" xdt:Transform="Replace" />
    <sessionState mode="StateServer" cookieName="__lap_b_report_uat" timeout="1400" stateConnectionString="tcpip=10.99.99.101:42424" cookieless="false" xdt:Transform="Replace"  />
    <!--<sessionState mode="Custom" cookieName="__lap_b_report" customProvider="LRFAppSessionStateStore" xdt:Transform="Replace" >
      <providers>
        <add name="LRFAppSessionStateStore" type="Microsoft.Web.Redis.RedisSessionStateProvider" applicationName="lrf_state" host="10.99.99.101" port="6379" accessKey="" ssl="false"  xdt:Transform="Replace" />
      </providers>
    </sessionState>-->
    <httpHandlers>
      <add path="*" verb="OPTIONS" type="System.Web.DefaultHttpHandler" validate="false" xdt:Transform="Insert"/>
    </httpHandlers>
  </system.web>
</configuration>