@using Fanex.Athena.Controllers.Account
@model UpdateCustCriteria

@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
    bool success = ViewBag.Success != null && ViewBag.Success;
}

@section pagecss {
    <link href="@Url.ContentLink("/Content/Plugin/bootstrap/bootstrap.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Account/reset.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Plugin/tipsy/tipsy-1.0.0.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Account/style.css")" rel="stylesheet" type="text/css" />
}
@section pagejs {
    <script src="@Url.ContentLink("/Scripts/Account/ManageAccount.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Account/Manage.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Plugin/tipsy/tipsy-1.0.0.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Account/NAP.js")" type="text/javascript"></script>
}

<div class="section-div">
    <div class="title">Edit User</div>
    @using (Html.BeginForm(null, null, FormMethod.Post, new { @role = "form", @class = "form-horizontal col-sm-7 col-md-5 common-form" }))
    {
        @Html.HiddenFor(c => c.CustId)

        <div class="form-group summary">
            @Html.ValidationSummary()
        </div>
        <div class="form-group required">
            <div class="col-xs-12 col-sm-3 lbl-field">
                @Html.LabelFor(c => c.Username)
            </div>
            <div class="col-xs-12 col-sm-8">
                @Html.TextBoxFor(c => c.Username, new { @class = "form-control" })
            </div>
        </div>
        <div class="form-group">
            <div class="col-xs-12 col-sm-3 lbl-field">
                @Html.LabelFor(c => c.FirstName)
            </div>
            <div class="col-xs-12 col-sm-8">
                @Html.TextBoxFor(c => c.FirstName, new { @class = "form-control" })
            </div>
        </div>
        <div class="form-group">
            <div class="col-xs-12 col-sm-3 lbl-field">@Html.LabelFor(c => c.LastName)</div>
            <div class="col-xs-12 col-sm-8">@Html.TextBoxFor(c => c.LastName, new { @class = "form-control" })</div>
        </div>
        <div class="form-group">
            <div class="col-xs-12 col-sm-3 lbl-field">@Html.LabelFor(c => c.Email)</div>
            <div class="col-xs-12 col-sm-8">@Html.TextBoxFor(c => c.Email, new { @class = "form-control" })</div>
        </div>
        <div class="form-group required">
            <div class="col-xs-12 col-sm-3 lbl-field">@Html.LabelFor(c => c.GroupId)</div>
            <div class="col-xs-12 col-sm-8">
                @Html.DropDownListFor(c => c.GroupId, (List<SelectListItem>)ViewBag.GroupSelectList, new { @class = "form-control" })
            </div>
        </div>
        <div class="form-group">
            <div class="col-sm-offset-3 col-xs-12 col-sm-8">
                @if (!success)
                {
                    <input type="submit" value="@ViewResources.Save" />
                    <button class="cancel-button" onclick="NAP.redirect('/Account/Manage/', 0); return false;">
                        @ViewResources.Cancel
                    </button>
                }
            </div>
        </div>


    }

</div>

@if (success)
{
    string dialogMsg = string.Format(ViewResources.Edit_User_Success, Model.Username, 3);

    <script type="text/javascript">
        var url = '/Account/Manage';
        NAP.showSuccessMsg('@dialogMsg', url, 3000);
    </script>
}