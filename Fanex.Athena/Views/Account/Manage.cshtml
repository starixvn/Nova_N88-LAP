@using Fanex.Athena.Controllers.Account;
@model IPagedList<UserLevel>

@{
    string titleFormat = @"LAP {0} {1} - {2}";
    ViewBag.Title = string.Format(titleFormat, HttpUtility.HtmlDecode("&bull;"),
                                         ViewResources.AccountManagement, ViewResources.ManageAccount);
    Layout = "~/Views/Shared/_AccountLayout.cshtml";


    var siteId = 1;
    var returnGroupId = 1;
    var CurrentPageIndex = 1;
}

@section pagecss {
    <link href="@Url.ContentLink("/Content/Global/lrf.global.reportable.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Account/reset.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Account/AccountManagement.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Plugin/tipsy/tipsy-1.0.0.css")" rel="stylesheet" type="text/css" />
}
@section pagejs {
    <script src="@Url.ContentLink("/Scripts/Account/Manage.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Plugin/tipsy/tipsy-1.0.0.js")" type="text/javascript"></script>
}

<div class="section-div">

    <div class="buttons-div">
        <div class="title">Manage User</div>
        <div class="button-action">
            @Html.ActionLink("+ " + ViewResources.CreateNewUser, "NewUser", "Account",
                    new
                    {
                        ReturnUserName = ViewBag.Username,
                        ReturnSiteId = siteId,
                        ReturnGroupId = returnGroupId,
                        ReturnPageIndex = CurrentPageIndex
                    }, new { @class = "add-button" })

        </div>
    </div>

    <div>
        @using (Html.BeginForm(null, null, FormMethod.Post, new { @role = "form", @class = "form-inline col-sm-12 filter-form" }))
        {
            <div class="form-group">
                @Html.Label(ViewResources.Username)
                <input type="hidden" value="@ViewBag.Criteria.Username" id="hdnUsename" />
                <input type="text" value="@ViewBag.Criteria.Username" name="userName" id="Username" />
            </div>
            <div class="form-group">
                @Html.Label("GroupId", ViewResources.Group)
                @Html.DropDownList("GroupId", (List<SelectListItem>)ViewBag.GroupSelectList, "All_Groups")
            </div>

            <div class="form-group">
                @Html.Label("StatusId", ViewResources.Status)
                @Html.DropDownList("StatusId", new List<SelectListItem> {
                new SelectListItem { Text = "All", Value = "0"  },
                new SelectListItem { Text = "Active", Value = "1" , Selected = true },
                new SelectListItem { Text = "Inactive", Value = "2"  },
                new SelectListItem { Text = "Closed", Value = "3"  }
            })
            </div>

            <div class="form-group">
                <input type="submit" value="@ViewResources.Submit" />
            </div>
        }
    </div>
    <table class="col-sm-12 grid">
        <thead>
            <tr>
                <th class="first">
                    #
                </th>
                <th>
                    @ViewResources.Username
                </th>
                <th>
                    @ViewResources.FirstName
                </th>
                <th>
                    @ViewResources.Group
                </th>
                <th>
                    @ViewResources.Creator
                </th>
                <th>
                    @ViewResources.CreatedDate
                </th>
                <th>
                    @ViewResources.LastLoginDate
                </th>
                <th>
                    @ViewResources.Status
                </th>
                <th>
                    @ViewResources.Action
                </th>
            </tr>
        </thead>

        <tbody id="grid-user">
            @if (!ReferenceEquals(Model, null) && Model.Count() > 0)
            {
                int i = 0;
                foreach (var item in Model)
                {
                    string rowCss = i % 2 == 0 ? string.Empty : "class='alt'";
                    var NA = "NA";

                    <tr @Html.Raw(rowCss)>
                        <td class="text-center">
                            @((Model.PageSize*(Model.PageNumber-2) + i + 1))
                        </td>
                        <td>
                            <a href="javascript:;" uid="@item.User.Id" class="lnk-user-info"
                               title="">@item.User.Username</a>
                        </td>
                        <td>
                            @(item.User.FirstName != null ? item.User.FirstName : string.Empty)
                        </td>
                        <td>
                            @(item.User.Group != null ? item.User.Group.Name : string.Empty)
                        </td>
                        <td>
                            @(item.User.Creator != null ? item.User.Creator.Username : string.Empty)
                        </td>
                        <td class="text-center">
                            @item.User.CreatedDate.ToFullDateString()
                        </td>
                        <td class="text-center">
                            @if (item.User.LastLoginDate != DateTime.MinValue)
                            {
                                @item.User.LastLoginDate.ToFullDateString()
                            }
                            else
                            {
                                @NA
                            }
                        </td>
                        <td class="text-center">
                            @{
                                var status = ((Constant.UserStatus)item.Status);

                                if (status != Constant.UserStatus.All)
                                {
                                    <div class="@(status == Constant.UserStatus.Closed ? "text-danger": string.Empty)">
                                        @status
                                    </div>
                                }
                            }
                        </td>

                        <td class="text-center">
                            @if (item.Level <= ViewBag.currentUserLevel)
                            {
                                <div class="action-wrp">

                                    <span class="btn-action btn-action-active">Action</span>
                                    <div class="relative">
                                        <ul class="actions">

                                            <li>
                                                @Html.ActionLink(string.Format("{0} '{1}' {2}", ViewResources.Edit, item.User.Username, ViewResources.Details),
                                     "Edit", new
                                     {
                                         id = item.User.Id
                                     }, new { @class = "dd-edit" })
                                            </li>
                                            <li>
                                                @Html.ActionLink(string.Format("{0} '{1}' {2}", ViewResources.Reset, item.User.Username, ViewResources.Password),
                                     "ResetPassword", new
                                     {
                                         id = item.User.Id
                                     }, new { @class = "dd-chgpwd" })
                                            </li>

                                            <li>
                                                @Html.ActionLink(string.Format("{0} of '{1}'", ViewResources.EditPermission, item.User.Username), "AssignPermission",
                                     new
                                     {
                                         id = item.User.Id
                                     }, new { @class = "dd-permission" })
                                            </li>
                                        </ul>
                                    </div>

                                </div>
                            }
                            else
                            {
                                <div class="action-wrp">
                                    <span class="btn-action btn-action-inactive">@ViewResources.Action</span>
                                </div>
                            }
                        </td>
                    </tr>

                    i++;
                }
            }
            else
            {
                <tr class="no-info">
                    <td colspan="12" class="text-center">
                        NoInformationAvailable
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="12">
                    @if (Model != null && Model.Count() > 0)
                    {
                        <span class="items-per-page-wrp">
                            @ViewResources.PageSize
                            @Html.DropDownList("items-per-page", new List<SelectListItem> {
                            new SelectListItem { Value = "10", Text = "10", Selected = "10" == Model.PageSize.ToString() },
                            new SelectListItem { Value = "20", Text = "20", Selected = "20" == Model.PageSize.ToString() },
                            new SelectListItem { Value = "30", Text = "30", Selected = "30" == Model.PageSize.ToString() }
                        }, new { id = string.Empty, @class = "items-per-page" })
                        </span>
                        @Html.Pager(Model.PageSize, Model.PageNumber-1, Model.TotalItemCount)
                    }
                </td>
            </tr>
        </tfoot>

    </table>


</div>