@using Fanex.Athena.Controllers.Account
@model ResetPasswordCustCriteria

@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

@section pagecss {
    <link href="@Url.ContentLink("/Content/Plugin/bootstrap/bootstrap.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Account/reset.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Plugin/tipsy/tipsy-1.0.0.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Account/style.css")" rel="stylesheet" type="text/css" />
}
@section pagejs {
    <script src="@Url.ContentLink("/Scripts/Account/ManageAccount.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Account/Manage.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Plugin/tipsy/tipsy-1.0.0.js")" type="text/javascript"></script>
}

    <div class="section-div">
        <div class="title">Reset Password</div>
        @using (Html.BeginForm(null, null, FormMethod.Post, new { id = "mainForm", @role = "form", @class = "form-horizontal col-sm-7 col-md-5 common-form" }))
        {
            @Html.HiddenFor(c => c.Token, new { id = "token" })
            @Html.HiddenFor(c => c.CustId, new { id = "custId" })

            <div class="form-group summary">
                <div class="col-sm-3">
                </div>
                <div class="col-sm-8">
                    @Html.ValidationSummary()
                </div>
            </div>
            <div class="form-group">
                <div class="col-xs-2 col-sm-4 lbl-field">
                    <label>Username</label>
                </div>
                <div class="col-xs-9 col-sm-7">
                    <label class="pull-left">@Model.Username</label>
                </div>
            </div>
            <div class="form-group">
                <div class="col-xs-12 col-sm-4 lbl-field">@Html.LabelFor(c => c.UserPwd)</div>
                <div class="col-xs-12 col-sm-7">
                    @Html.PasswordFor(c => c.UserPwd, new { id = "UserPwd", @class = "form-control" })
                </div>
            </div>
            <div class="form-group">
                <div class="col-xs-12 col-sm-4 lbl-field">@Html.LabelFor(c => c.ConfirmUserPwd)</div>
                <div class="col-xs-12 col-sm-7">
                    @Html.PasswordFor(c => c.ConfirmUserPwd, new { id = "ConfirmUserPwd", @class = "form-control" })
                </div>
            </div>
            <div class="form-group">
                <div class="col-sm-offset-4 col-xs-12 col-sm-7">
                    <input type="submit" value="Save" />
                    <button class="cancel-button">Cancel</button>
                </div>
            </div>
        }

    </div>