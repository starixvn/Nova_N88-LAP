@using Fanex.Athena.Controllers.Account
@using Fanex.Athena.Model.UserManagement.Criteria
@model ResetPasswordCustCriteria

@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
    bool success = ViewBag.Success != null && ViewBag.Success;
}

@section pagecss {
    <link href="@Url.ContentLinkByEnv("/www/css/build/pages/user/edituser.css")" rel="stylesheet" type="text/css" />
}
@section pagejs {
    <script src="@Url.ContentLink("/Scripts/Account/jquery.validate.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Account/jquery.validate.unobtrusive.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Account/msgbox-0.0.1.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Account/NAP.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Account/CryptoJS.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Account/ResetPassword.js")" type="text/javascript"></script>
}

<div class="container-fluid">
    <div class="breadcrumb">
        <a class="level level-link" href="javascript:;"
           onclick="NAP.redirect('/Account/Manage/', 0); return false;">@ViewResources.ManageUser</a>
        <i class="icon-arrow"></i>
        <a class="level" href="javascript:;">@ViewResources.ResetPassword</a>
    </div>

    @using (Html.BeginForm(null, null, FormMethod.Post, new { id = "mainForm", @role = "form", @class = "form-horizontal" }))
    {
        @Html.HiddenFor(c => c.Token, new { id = "token" })
        @Html.HiddenFor(c => c.UserId, new { id = "UserId" })
        @Html.HiddenFor(c => c.Username, new { id = "Username" })

        <div class="form-group">
            @Html.ValidationSummary()
        </div>
        <div class="form-group">
            <div class="label-text">@ViewResources.Username</div>
            <div class="input-text disabled">@Model.Username</div>
        </div>
        <div class="form-group">
            @Html.LabelFor(c => c.UserPwd, new { @class = "label-text" })
            @Html.PasswordFor(c => c.UserPwd, new { id = "UserPwd", @class = "input-text" })
        </div>
        <div class="form-group">
            @Html.LabelFor(c => c.ConfirmUserPwd, new { @class = "label-text" })
            @Html.PasswordFor(c => c.ConfirmUserPwd, new { id = "ConfirmUserPwd", @class = "input-text" })
        </div>
        <div class="form-group">
            @if (!success)
            {
                <input type="submit" class="btn btn-submit" value="@ViewResources.Save" />
                <button class="btn btn-cancel" onclick="NAP.redirect('/Account/Manage/', 0); return false;">@ViewResources.Cancel</button>
            }
        </div>
    }
</div>
@if (!success)
{
<form id="hiddenForm" method="post" novalidate="novalidate">
    @Html.HiddenFor(c => c.Token, new { id = "token" })
    @Html.HiddenFor(c => c.UserId, new { id = "UserId" })
    @Html.HiddenFor(c => c.Username, new { id = "username" })
    @Html.HiddenFor(c => c.UserPwd, new { id = "newPassword" })
    @Html.HiddenFor(c => c.ConfirmUserPwd, new { id = "confirmPassword" })
</form>
}
@if (success)
{
    string dialogMsg = string.Format(ViewResources.Update_Password_Success, Model.Username, 3);

    <script type="text/javascript">
        var url = '/Account/Manage';
        NAP.showSuccessMsg('@dialogMsg', url, 3000);
    </script>
}