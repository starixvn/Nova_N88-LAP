@using Fanex.Athena.Controllers.Account
@using Fanex.Athena.Model.UserManagement.Criteria
@model SetDataLimitsCriteria

@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
    bool success = ViewBag.Success != null && ViewBag.Success;
    var successMsg = string.Empty;
}

@section pagecss {
    <link href="@Url.ContentLinkByEnv("/www/css/build/pages/user/setdatalimits.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Themes/12Bet/Site.css")" rel="Stylesheet" />
    <link href="@Url.ContentLink("/Content/Global/Global.css")" rel="Stylesheet" />
}
@section pagejs {
    <script src="@Url.ContentLink("/Scripts/Account/msgbox-0.0.1.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Account/NAP.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Account/SetDataLimits.js")" type="text/javascript"></script>
}

<div class="container-fluid">
    <div class="breadcrumb">
        <a class="level level-link" href="javascript:;"
           onclick="NAP.redirect('Account/Manage/', 0); return false;">@ViewResources.ManageUser</a>
        <i class="icon-arrow"></i>
        <a class="level" href="javascript:;">@string.Format("{0} of '{1}'", ViewResources.SetDataLimits, Model.Username)</a>
    </div>

    @using (Html.BeginForm(null, null, FormMethod.Post, new { @role = "form", @class = "form-horizontal" }))
    {
        @Html.HiddenFor(c => c.UserId)
        @Html.HiddenFor(c => c.Username)

        <div class="form-group">
            @Html.ValidationSummary()
        </div>
        <p><b>@ViewResources.AllReportsSetting</b></p>
        <div class="form-group">
            <input type="checkbox" class="checkbox checkbox-input" value="true" @(Model.IsAllReportDataLimitsApplied ? "checked=checked" : "") name="IsAllReportDataLimitsApplied" id="all-report-data-limits-applied" />
            <label for="all-report-data-limits-applied" class="label-text">
                @ViewResources.AllReportDataLimitsLabel
                <input id="date-limit-input" type="number" class="input-text input-radio-inline" name="AllReportDataLimits" value="@Model.AllReportDataLimits" disabled />
                @ViewResources.Days
            </label>
        </div>
        <p><b>@ViewResources.WinLossAnalysisSetting</b></p>
        <div class="form-group">
            <input type="checkbox" class="checkbox" value="true" @(Model.IsWinLossAnalysisSinglePlayerApplied ? "checked=checked" : "") name="IsWinLossAnalysisSinglePlayerApplied" id="WinLossAnalysisSinglePlayer" />
            <label for="WinLossAnalysisSinglePlayer" class="label-text">
                @ViewResources.WinLossAnalysisSinglePlayerSettingLabel
            </label>
        </div>

        <div class="form-group">
            <ul>
                <li>
                    <input type="checkbox" class="checkbox check-all checkbox-input" value="true" name="WinLossAnalysisDataLimitsTop.IsApplied" id="WinLossAnalysisDataLimitsTop" />
                    <label for="WinLossAnalysisDataLimitsTop" class="label-text">
                        @ViewResources.WinLossAnalysisDataLimitsTopLabel
                        <input id="winloss-analysis-data-limits-top-input" type="number"class="input-text input-radio-inline" name="WinLossAnalysisDataLimitsTop.Value" value="@Model.WinLossAnalysisDataLimitsTop.Value" disabled />
                        @ViewResources.Players
                    </label>
                    <ul>
                        <li>
                            <input type="checkbox" class="checkbox" value="true" @(Model.WinLossAnalysisDataLimitsTop.IsTurnoverApplied ? "checked=checked" : "") name="WinLossAnalysisDataLimitsTop.IsTurnoverApplied" id="TopTurnover" />
                            <label for="TopTurnover" class="label-text sub-checkbox">
                                @ViewResources.Turnover
                            </label>
                        </li>
                        <li>
                            <input type="checkbox" class="checkbox" value="true" @(Model.WinLossAnalysisDataLimitsTop.IsGGRApplied ? "checked=checked" : "") name="WinLossAnalysisDataLimitsTop.IsGGRApplied" id="TopGGR" />
                            <label for="TopGGR" class="label-text sub-checkbox">
                                @ViewResources.GGR
                            </label>
                        </li>
                        <li>
                            <input type="checkbox" class="checkbox" value="true" @(Model.WinLossAnalysisDataLimitsTop.IsBetCountApplied ? "checked=checked" : "") name="WinLossAnalysisDataLimitsTop.IsBetCountApplied" id="TopBetCount" />
                            <label for="TopBetCount" class="label-text sub-checkbox">
                                @ViewResources.BetCount
                            </label>
                        </li>
                        <li>
                            <input type="checkbox" class="checkbox" value="true" @(Model.WinLossAnalysisDataLimitsTop.IsAvgBetAmountApplied ? "checked=checked" : "") name="WinLossAnalysisDataLimitsTop.IsAvgBetAmountApplied" id="TopAvgBetAmount" />
                            <label for="TopAvgBetAmount" class="label-text sub-checkbox">
                                @ViewResources.AvgBetAmount
                            </label>
                        </li>
                        <li>
                    </ul>
                </li>
            </ul>
        </div>
        <div class="form-group">
            <ul>
                <li>
                    <input type="checkbox" class="checkbox check-all checkbox-input" value="true" name="WinLossAnalysisDataLimitsBottom.IsApplied" id="WinLossAnalysisDataLimitsBottom" />
                    <label for="WinLossAnalysisDataLimitsBottom" class="label-text">
                        @ViewResources.WinLossAnalysisDataLimitsBottomLabel
                        <input id="winloss-analysis-data-limits-bottom-input" type="number" class="input-text input-radio-inline" name="WinLossAnalysisDataLimitsBottom.Value" value="@Model.WinLossAnalysisDataLimitsBottom.Value" disabled />
                        @ViewResources.Players
                    </label>
                    <ul>
                        <li>
                            <input type="checkbox" class="checkbox" value="true" @(Model.WinLossAnalysisDataLimitsBottom.IsTurnoverApplied ? "checked=checked" : "") name="WinLossAnalysisDataLimitsBottom.IsTurnoverApplied" id="BottomTurnover" />
                            <label for="BottomTurnover" class="label-text sub-checkbox">
                                @ViewResources.Turnover
                            </label>
                        </li>
                        <li>
                            <input type="checkbox" class="checkbox" value="true" @(Model.WinLossAnalysisDataLimitsBottom.IsGGRApplied ? "checked=checked" : "") name="WinLossAnalysisDataLimitsBottom.IsGGRApplied" id="BottomGGR" />
                            <label for="BottomGGR" class="label-text sub-checkbox">
                                @ViewResources.GGR
                            </label>
                        </li>
                        <li>
                            <input type="checkbox" class="checkbox" value="true" @(Model.WinLossAnalysisDataLimitsBottom.IsBetCountApplied ? "checked=checked" : "") name="WinLossAnalysisDataLimitsBottom.IsBetCountApplied" id="BottomBetCount" />
                            <label for="BottomBetCount" class="label-text sub-checkbox">
                                @ViewResources.BetCount
                            </label>
                        </li>
                        <li>
                            <input type="checkbox" class="checkbox" value="true" @(Model.WinLossAnalysisDataLimitsBottom.IsAvgBetAmountApplied ? "checked=checked" : "") name="WinLossAnalysisDataLimitsBottom.IsAvgBetAmountApplied" id="BottomAvgBetAmount" />
                            <label for="BottomAvgBetAmount" class="label-text sub-checkbox">
                                @ViewResources.AvgBetAmount
                            </label>
                        </li>
                    </ul>
                </li>
            </ul>
        </div>
        <div class="form-group">
            @if (!success)
            {
                <input type="submit" class="btn btn-submit" value="@ViewResources.Save" />
                <button class="btn btn-cancel" onclick="NAP.redirect('Account/Manage/', 0); return false;">
                    @ViewResources.Cancel
                </button>
            }
        </div>
    }
</div>

@if (success)
{
    string dialogMsg = string.Format(ViewResources.EditSuccessMsg, ViewResources.User + " '" + Model.Username + "'", 3);

    <script type="text/javascript">
        var url = 'Account/Manage';
        NAP.showSuccessMsg('@dialogMsg', url, 4000);
    </script>
}