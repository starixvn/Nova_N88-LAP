@{
    ViewBag.Title = ViewResources.Report +
    " - " + "Betting Tickets Center";
    Layout = "~/Views/Desktop/Shared/_ReactPageLayout.cshtml";
}
@using Fanex.Athena.Model.Core.DataDomain
@model Fanex.Athena.Model.BetList.ViewModel.BettingTicketCenterViewModel
@{
    var productOptions = Model.ProductOptionList;
    var selectedProductCode = string.Join(",", productOptions.Where(x => x.Status).Select(x => x.Code).ToArray());

    var selectedCurrency = string.Join(",", Model.OwnBrand.CurrencyList.Select(x => x.Key).ToArray());
    var baseCurrencyList = SystemConstants.BaseCurrencyList.Select(c => new
    {
        value = c.Value,
        label = c.Value
    }).ToList();
    var selectedStatus = string.Join(",", Model.StatusList.Where(x => x.Checked).Select(x => x.ID).ToArray());
    var brands = Model.Brands.Select(x => new
    {
        id = x.Id,
        currencies = x.CurrencyList.Select(y => new { key = y.Key, value = y.Value })
    });
    var allowSelectBrand = Model.Brands.Count() > 1;
}
@section pagecss {
    <link href="@Url.ContentLinkByEnv("/www/css/build/reactpages/betlist/index.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLinkByEnv("/www/css/build/reactpages/bettingticketscenter/index.css")" rel="stylesheet" type="text/css" />
}
@section pagejs {
    <script src="@Url.ContentLinkByEnv("/www/js/build/reactpages/bettingticketscenter/running.chunk.js")"></script>
}

@section globaljscode{
    window.initialState = {
    selectedProduct: '@(selectedProductCode)',
    selectedBrand: @Model.OwnBrand.Id,
    username: '',
    selectedCurrency: '@(selectedCurrency)',
    selectedBaseCurrency: '@(Model.SelectedBaseCurrency)',
    isLoading: false,
    selectedStatus: '@(selectedStatus)',
    isConvertAll: true
    };
    window._AppData = {
    allowSelectBrand: @allowSelectBrand.ToString().ToLowerInvariant(),
    brands: @Html.Raw(brands.ToJson()),
    isAllowedCustomerComm: @Model.IsAllowedCustomerComm.ToJson(),
    productOptions: @Html.Raw(productOptions.ToJson()),
    brandOptions: @Html.Raw(Model.Brands.Select(x => new { value = x.Id, label = x.Name }).ToJson()),
    baseCurrencyList: @Html.Raw(baseCurrencyList.ToJson()),
    statusList: @Html.Raw(Model.StatusList.Select(x => new { Id = x.ID, Value = x.Name, Status = x.Checked }).ToJson()),
    tabList: @Html.Raw(Model.TabList.ToJson())
    };
}
<div id="app-container">
</div>