@{
    Layout = null;
}
@model Fanex.Athena.Model.Core.ViewModel.HeaderPageViewModel

<nav class="nav-wrapper">
    <a href="javascript:;" class="logo">
        <span class="logo-text hide-on-med-and-down"><img src="@Url.ContentLink(Model.LogoTextUrl)" /></span>
        <span class="icon-hambuger toggleMenubar" id="js-toggleMenubar" data-activates="nav-mobile">
            <span class="lines"></span>
        </span>
    </a>
    <div class="page-title"><span id="page-title" class="active"></span></div>
    <div class="right-block">
        <div class="navbar-avatar">
            <a class="dropdown-button" href="javascript:void(0)" data-activates="profile">
                <img class="avatar" src="@Url.ContentLink("/www/assets/images/15.jpg")" alt="@Html.Encode(Model.UserName)">
                <span class="name hide-on-med-and-down">@Html.Encode(Model.UserName)</span>
                <i class="icon icon-menu-down" aria-hidden="true"></i>
            </a>

            <ul id="profile" class="dropdown-content profile-items">
                <li id ="edit-userinfo">
                    <i class="icon icon-account-circle"></i>
                    <a href="@Url.Content("~/Account/EditUserInfo")" target="main">@ViewResources.UserInfo</a>
                </li>
                <li>
                    <i class="icon icon-account"></i>
                    <a href="@Url.Content("~/Authorization/ChangePassword")" target="main">@ViewResources.ChangePassword</a>
                </li>
                <li>
                    <i class="icon icon-logout"></i>
                    <a href="@Url.Content("~/Authorization/SignOut")">@ViewResources.Logout</a>
                </li>
            </ul>
        </div>
        @if (Model.IsAllowedNotification)
        {
            <div class="notifications-block">
                <a class="notification-button" href="javascript:void(0)">
                    <i class="icon-notification"></i>
                </a>

                <ul id="notificationmsg" class="notification-content">
                    <li class="first-notification"></li>
                </ul>
            </div>
        }
    </div>

    <div class="clock-block">
        <span class="icon-clock"></span><span id="clock"></span>@DateTime.Now.ToString("%z")
    </div>
</nav>
