@{
    Layout = null;
    var icons = new Dictionary<int, string>
    {
        { 1, "totalbet" }, { 2, "chart-bar" }, { 3, "table" }, { 5, "table" }, { 6, "administration" }, { 52, "table" }, { 4, "customer" }
    };
}
@using Fanex.Athena.Resources
@using Fanex.N88.Core.Models
@model IEnumerable<MenuItem>

@helper getMenuTitle(MenuItem menu) {
    if (string.IsNullOrWhiteSpace(menu.Key))
    {
        @menu.Name
    }
    else
    {
        @Menu.ResourceManager.GetString(menu.Key)
    }
}

<ul class="collapsible2 collapsible-expandable" data-collapsible="accordion">
    @{ IEnumerable<MenuItem> menus = Model.Where(t => t.Parent == null); }
    @foreach (MenuItem menu in menus)
    {
        IEnumerable<MenuItem> subMenus = Model.Where(t => t.Parent != null && t.Parent.Id == menu.Id);
        <li class="menu-item @(subMenus.Any() ? "has-sub" : string.Empty)">
            @if (menu.Url == "")
            {
                <a class="collapsible-header waves-effect">
                    <i class="menu-icon icon-table" aria-hidden="true"></i>
                    <span class="menu-title">@getMenuTitle(menu)</span>
                    <i class="right icon-arrow"></i>
                </a>
            }
            else
            {
                <a class="collapsible-header waves-effect" id="MenuItem@(menu.Id)" href="@Url.Content("~/" + menu.Url)" target="main">
                    <i class="menu-icon icon-table" aria-hidden="true"></i>
                    <span class="menu-title">@getMenuTitle(menu)</span>
                </a>
            }

            @if (subMenus.Any())
            {
                <div class="collapsible-body">
                    <ul>
                        @foreach (MenuItem subMenu in subMenus)
                        {
                            <li>
                                <a id="MenuItem@(subMenu.Id)" href="@Url.Content("~/" + subMenu.Url)" target="main">
                                    @getMenuTitle(subMenu)
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </li>
    }
</ul>