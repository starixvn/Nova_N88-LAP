@{
    ViewBag.Title = "Customer Administration";
    Layout = "~/Views/Desktop/Shared/_ReactPageLayout.cshtml";

    var serializer = new JavaScriptSerializer();
}
@model Fanex.Athena.Model.PlayerManagement.ViewModel.PlayerAdminViewModel
@using System.Web.Script.Serialization

@section pagecss {
    <link href="@Url.ContentLinkByEnv("/www/css/build/reactpages/playeradmin/index.css")" rel="stylesheet" type="text/css" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
}
@section pagejs {
    <script src="@Url.ContentLinkByEnv("/www/js/build/reactpages/playeradmin/playerlist.chunk.js")"></script>
    <script src="@Url.ContentLinkByEnv("www/js/build/reactpages/lib/xlsx-style-sparta.chunk.js")" async></script>
}

@section globaljscode{
    window.initialState = {
    isLoading: false,
    type: 0,
    currencyList:  @Html.Raw(Model.CurrencyList.Select(x => new { Id = x.Key.ToString(), Value = x.Value, Status = true }).ToJson()),
    isSubsidiary:  0
    };

    window._pConfig = {
    hostUrl: '@Url.Content("~/")',
    applyApiTokenUrl: '@Url.Action("ApplyApiToken", "Verify")',
    applyLinkTokenUrl: '@Url.Action("ApplyToken", "Verify")',
    tabList: @Html.Raw(Model.PlayerTabItems),
    hasBaPermission:  @Html.Raw((new { isallowed = (bool)Model.IsAllowedBA.Key, policy = Model.IsAllowedBA.Value }).ToJson()),
    hasOddsGroupPermission: @Html.Raw((new { isallowed = (bool)Model.IsAllowedOddGroup.Key, policy = Model.IsAllowedOddGroup.Value }).ToJson()),
    hasSpecialLevelPermission: @Html.Raw((new { isallowed = (bool)Model.IsAllowedSpecialLevel.Key, policy = Model.IsAllowedSpecialLevel.Value }).ToJson()),
    };
}
<div id="app-container">
</div>
