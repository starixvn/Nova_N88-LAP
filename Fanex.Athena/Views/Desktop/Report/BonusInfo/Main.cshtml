@{
    ViewBag.Title = ViewResources.Report + " - " + ViewResources.BonusInfo;
    Layout = "~/Views/Desktop/Shared/_ReactPageLayout.cshtml";
}

@using Fanex.Athena.Model.Core.DataDomain

@model Fanex.Athena.Model.Report.ViewModel.BonusInfoViewModel

@{
    var baseCurrencyList = SystemConstants.BaseCurrencyList.Select(c => new
    {
        value = c.Value,
        label = c.Value
    }).ToList();

    var selectedCurrency = string.Join(",", Model.OwnBrand.TpCurrencyList.Select(x => x.Key).ToArray());

    var brands = Model.Brands.Select(x => new
    {
        id = x.Id,
        tpCurrencies = x.TpCurrencyList.Select(y => new { key = y.Key, value = y.Value })
    });
}

@section pagecss {
    <link href="@Url.ContentLinkByEnv("/www/css/build/reactpages/report/bonusinfo.css")" rel="stylesheet" type="text/css" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
}
@section pagejs {
    <script src="@Url.ContentLinkByEnv("/www/js/build/reactpages/report/bonusinfo.chunk.js")"></script>
}

@section globaljscode{
    window.initialState = {
    selectedBaseCurrency: '@Model.BaseCurrency',
    selectedCurrency: '@selectedCurrency',
    selectedBrand: @Model.OwnBrand.Id,
    selectedBonusName: "",
    dateRange: { fromDate: '@Model.FromDate.ToString("MM/dd/yyyy")', toDate: '@Model.ToDate.ToString("MM/dd/yyyy")' }
    };

    window._AppData = {
    brands: @Html.Raw(brands.ToJson()),
    dateConstraint: {
    limitedMonthRange: @Model.LimitMonthRange,
    minDate: '@Model.MinDate.ToString("MM/dd/yyyy")',
    maxDate: '@Model.MaxDate.ToString("MM/dd/yyyy")'
    },
    baseCurrencyList: @Html.Raw(baseCurrencyList.ToJson()),
    brandOptions: @Html.Raw(Model.Brands.Select(x => new { value = x.Id, label = x.Name }).ToJson()),
    today: '@Model.Today.ToString("MM/dd/yyyy")'
    }

}
<div id="app-container">
</div>