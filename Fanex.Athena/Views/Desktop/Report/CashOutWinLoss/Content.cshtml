@{
    Layout = null;
}

<div class="page-results">
    <div class="breadcrumb" id="level-link-container" style="display: none">
        <a class="level level0 level-link" data-level="0" href="javascript:;">@ViewResources.Main</a>
        <i class="icon-arrow level1"></i>
        <a class="level level1 level-link" data-level="1" href="javascript:;">@ViewResources.Customer</a>
        <i class="icon-arrow level2"></i>
        <a class="level level2" href="javascript:;">@ViewResources.Customer</a>
    </div>
    <div class="result-content">
        <div class="panel-heading active hide">
            <div class="panel-title">
                <span class="report-title"></span>
            </div>
        </div>

        <div class="main-content">
            <div class="panel-body">
                <div class="theme_jqGrid">
                    <table id="ReportGrid" class="table" data-hidden-column=""></table>
                    <div id="ppdata"></div>
                    <div id="footer" class="hide"></div>
                </div>
            </div>
        </div>
    </div>
</div>