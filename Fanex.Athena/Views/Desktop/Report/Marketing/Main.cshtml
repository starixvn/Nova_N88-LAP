@{
    ViewBag.Title = ViewResources.Report + " - " + ViewResources.Marketing;
    Layout = "~/Views/Desktop/Shared/_ReactPageLayout.cshtml";
}

@using Fanex.Athena.Model.Core.DataDomain

@model Fanex.Athena.Model.Report.ViewModel.MarketingViewModel

@{
    var baseCurrencyList = SystemConstants.BaseCurrencyList.Select(c => new
    {
        value = c.Value,
        label = c.Value
    }).ToList();
}

@section pagecss {
    <link href="@Url.ContentLinkByEnv("/www/css/build/reactpages/report/marketing.css")" rel="stylesheet" type="text/css" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
}
@section pagejs {
    <script src="@Url.ContentLinkByEnv("/www/js/build/reactpages/report/marketing.chunk.js")"></script>
}

@section globaljscode{
    window.initialState = {
        selectedBaseCurrency: '@Model.BaseCurrency',
        selectedBrand: @Model.OwnBrand.Id
    };

    window._AppData = {
        dateConstraint: {
            limitedMonthRange: @Model.LimitMonthRange,
            minDate: '@Model.MinDate.ToString("MM/dd/yyyy")',
            maxDate: '@Model.MaxDate.ToString("MM/dd/yyyy")'
        },
        baseCurrencyList: @Html.Raw(baseCurrencyList.ToJson()),
        brandOptions: @Html.Raw(Model.Brands.Select(x => new { value = x.Id, label = x.Name }).ToJson()),
        productOptions: @Html.Raw(Model.TpProducts.Select(x => new { key = x.Id, value = x.Name, status = true }).ToJson()),
        defaultSelectedProduct: '@string.Join(",", Model.TpProducts.Select(x => x.Id).ToArray())',
        today: '@Model.Today.ToString("MM/dd/yyyy")'
    }

}
<div id="app-container">
</div>