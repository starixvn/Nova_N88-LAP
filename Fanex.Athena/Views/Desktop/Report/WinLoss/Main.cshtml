@{
    ViewBag.Title = ViewResources.Report + " - " + ViewResources.WinLossAnalysis;
    Layout = "~/Views/Desktop/Shared/_ReactPageLayout.cshtml";
}

@using Fanex.Athena.Model.Core.DataDomain

@model Fanex.Athena.Model.Report.ViewModel.WinLossViewModel

@{
    var baseCurrencyList = SystemConstants.BaseCurrencyList.Select(c => new
    {
        value = c.Value,
        label = c.Value
    }).ToList();

    var selectedDataView = Model.IsAllowedDataView ? Model.DataView.FirstOrDefault().Id : 0;

    var dataViewList = Model.DataView.Select(view => new
    {
        value = view.Id,
        label = view.Name
    }).ToList();

    var brands = Model.Brands.Select(x => new
    {
        id = x.Id,
        tpCurrencies = x.TpCurrencyList.Select(y => new { key = y.Key, value = y.Value })
    });
}

@section pagecss {
    <link href="@Url.ContentLinkByEnv("/www/css/build/reactpages/report/winloss.css")" rel="stylesheet" type="text/css" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
}
@section pagejs {
    <script src="@Url.ContentLinkByEnv("/www/js/build/reactpages/report/winloss.chunk.js")"></script>
}

@section globaljscode{
    window.initialState = {
    selectedDateType: 1,
    dateRange: { fromDate: '@Model.FromDate.ToString("MM/dd/yyyy")', toDate: '@Model.ToDate.ToString("MM/dd/yyyy")' },
    isExcludeTest: true,
    noDraw: true,
    drilldownInOriginalCurrency: false,
    isLoading: false,
    selectedBaseCurrency: '@Model.BaseCurrency',
    selectedDataView: @selectedDataView,
    selectedCurrency: '@string.Join(",", Model.OwnBrand.TpCurrencyList.Select(x => x.Key))',
    selectedProduct: '@string.Join(",", Model.TpProducts.Select(x => x.Id).ToArray())',
    selectedBrand: '@Model.OwnBrand.Id',
    selectedPlayerList: '@Model.TopBottomPlayerList.FirstOrDefault().Key',
    userNameFilterOption: 1,
    username: "",
    };

    window._AppData = {
    brands: @Html.Raw(brands.ToJson()),
    dateConstraint: {
    limitedMonthRange: @Model.LimitMonthRange,
    minDate: '@Model.MinDate.ToString("MM/dd/yyyy")',
    maxDate: '@Model.MaxDate.ToString("MM/dd/yyyy")'
    },
    isAllowedGroupByDate: '@Model.IsAllowedGroupByDate' === 'True',
    isAllowedGroupByMonth: '@Model.IsAllowedGroupByMonth' === 'True',
    isAllowedGroupByProduct: '@Model.IsAllowedGroupByProduct' === 'True',
    isAllowedGroupByPlayerSingle: '@Model.IsAllowedGroupByPlayerSingle' === 'True',
    isAllowedGroupByPlayer: '@Model.IsAllowedGroupByPlayer' === 'True',
    isAllowedGroupByCurrency: '@Model.IsAllowedGroupByCurrency' === 'True',
    isAllowedGroupByBrand: '@Model.IsAllowedGroupByBrand' === 'True',
    isAllowedReportBetlist: '@Model.IsAllowedReportBetlist' === 'True',
    dataView: '@Model.IsAllowedDataView' === 'True',
    specialReportDataPermission: {
    turnover: '@Model.IsAllowedTurnover' === 'True',
    netTurnover: '@Model.IsAllowedValidTurnover' === 'True',
    ggr: '@Model.IsAllowedGGR' === 'True',
    playerWinloss: '@Model.IsAllowedPlayerWinLoss' === 'True',
    depositAmount: '@Model.IsAllowedTotalDepositAmount' === 'True',
    withdrawalAmount: '@Model.IsAllowedTotalWithdrawalAmount' === 'True',
    margin: '@Model.IsAllowedMargin' === 'True',
    avgBetAmount: '@Model.IsAllowedAvgBetAmount' === 'True'
    },
    productOptions: @Html.Raw(Model.TpProducts.Select(x => new { key = x.Id, value = x.Name, status = true }).ToJson()),
    brandOptions: @Html.Raw(Model.Brands.Select(x => new { key = x.Id, value = x.Name, status = Model.OwnBrand.Id == x.Id }).ToJson()),
    playerListOptions: @Html.Raw(Model.TopBottomPlayerList.Select(x => new { value = x.Key, label = x.Value }).ToJson()),
    baseCurrencyList: @Html.Raw(baseCurrencyList.ToJson()),
    dataViewList: @Html.Raw(dataViewList.ToJson())
    }

}
<div id="app-container">
</div>