@{
    ViewBag.Title = ViewResources.Report + " - " + ViewResources.WinLossAnalysis;
    Layout = "~/Views/Desktop/Shared/_ReactPageLayout.cshtml";
}

@using Fanex.Athena.Model.Core.DataDomain

@model Fanex.Athena.Model.Report.ViewModel.WinLossViewModel

@{
    var baseCurrencyList = SystemConstants.BaseCurrencyList.Select(c => new
    {
        value = c.Value,
        label = c.Value
    }).ToList();

    var brands = Model.Brands.Select(x => new
    {
        id = x.Id,
        tpCurrencies = x.TpCurrencyList.Select(y => new { key = y.Key, value = y.Value })
    });
}

@section pagecss {
    <link href="@Url.ContentLinkByEnv("/www/css/build/reactpages/report/winloss.css")" rel="stylesheet" type="text/css" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
}
@section pagejs {
    <script src="@Url.ContentLinkByEnv("/www/js/build/reactpages/report/winloss.chunk.js")"></script>
}

@section globaljscode{
    window.initialState = {
    selectedDateType: 1,
    dateRange: { fromDate: '@Model.FromDate.ToString("MM/dd/yyyy")', toDate: '@Model.ToDate.ToString("MM/dd/yyyy")' },
    isExcludeTest: true,
    noDraw: true,
    drilldownInOriginalCurrency: false,
    isLoading: false,
    selectedBaseCurrency: '@Model.BaseCurrency',
    selectedCurrency: '@string.Join(",", Model.OwnBrand.TpCurrencyList.Select(x => x.Key))',
    selectedProduct: '@string.Join(",", Model.TpProducts.Select(x => x.Id).ToArray())',
    selectedBrand: '@Model.OwnBrand.Id',
    userNameFilterOption: 1,
    username: "",
    };

        window._AppData = {
            brands: @Html.Raw(brands.ToJson()),
    dateConstraint: {
                limitedMonthRange: @Model.LimitMonthRange,
    minDate: '@Model.MinDate.ToString("MM/dd/yyyy")',
    maxDate: '@Model.MaxDate.ToString("MM/dd/yyyy")'
    },

    productOptions: @Html.Raw(Model.TpProducts.Select(x => new { key = x.Id, value = x.Name, status = true }).ToJson()),
    brandOptions: @Html.Raw(Model.Brands.Select(x => new { key = x.Id, value = x.Name, status = Model.OwnBrand.Id == x.Id }).ToJson()),
    baseCurrencyList: @Html.Raw(baseCurrencyList.ToJson()),
    }

    }
<div id="app-container">
</div>