@{
    Layout = null;
    Page.Title = "Error!!!!!";
}
<!DOCTYPE html>
<html>
<head>
    <title>@Page.Title</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0">
    <title>Error!!!!!</title>
    <link href="@Url.ContentLinkByEnv("/www/css/build/pages/utility/error.css")" rel="stylesheet" />
    <style>
        body {
            font-family: Verdana,'sans-serif';
            font-size: .8rem;
        }

        .center {
            margin: auto;
            width: 50%;
            padding: 10px;
            text-align: center;
        }

        ol {
            counter-reset: item;
        }

            ol li {
                display: block;
            }

                ol li:before {
                    content: counter(item) ". ";
                    counter-increment: item;
                    font-weight: bold;
                }
    </style>
</head>
<body>
    <div class="error-content">
        <img src="@Url.ContentLink("/www/assets/images/mpa-error-page.svg")" />
        <div class="center">
            <div>
                <strong style="color:#0F3630">@ViewResources.ErrorNotification</strong>
            </div>
            <ol style="list-style-type: decimal;">
                <li style="color:#F15D22">
                    @Html.Raw(ViewBag.Message)
                </li>
            </ol>
            <div>
                <strong style="color:#0F3630">@ViewResources.TryLogin</strong>
            </div>
            <ul style="list-style-type: none;">
                @Html.Raw(ViewResources.SolutionForRestriction)
            </ul>
        </div>
    </div>
</body>
</html>