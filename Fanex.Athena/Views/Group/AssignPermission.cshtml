@using Fanex.Athena.Model.UserManagement.Model
@model Fanex.Athena.Model.UserManagement.Criteria.AssignFunctionGroupCriteria
@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";

    ViewBag.Title = ViewBag.HasAssignFunctionRight
        ? string.Format("Assign Permission to Group '{0}'", Model.GroupName)
        : string.Format("Permission of Group '{0}'", Model.GroupName);

    bool success = ViewBag.Success != null && ViewBag.Success;
    var functionList = ViewBag.FunctionList as List<AccFunction>;
    var groupFuncPolicyList = ViewBag.GroupFuncPolicyList as List<FunctionPolicy>;
    var userFuncPolicyList = ViewBag.UserFuncPolicyList as List<FunctionPolicy>;
    var userLevel = ViewBag.UserLevel as int?;
    var successMsg = string.Empty;
}
@section pagecss {
    <link href="@Url.ContentLinkByEnv("/www/css/build/pages/user/assignpermission.css")" rel="stylesheet" type="text/css" />
}
@section pagejs {
    <script src="@Url.ContentLink("/Scripts/Account/msgbox-0.0.1.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Account/NAP.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Group/AssignPermission.js")" type="text/javascript"></script>
}

<div class="container-fluid">
    <div class="breadcrumb">
        <a class="level level-link" href="@Url.Action("Manage", "Group", null)">@Menu.ManageGroup</a>
        <i class="icon-arrow"></i>
        <a class="level" href="javascript:;">@ViewBag.Title</a>
    </div>

    @using (Html.BeginForm())
    {
        <div class="form-group">
            <div class="validation-summary-valid" data-valmsg-summary="true">
                <ul>
                    <li style="display:none">@successMsg</li>
                </ul>
            </div>
        </div>

        <table class="table">
            <thead>
                <tr class="level1">
                    <th rowspan="2">@ViewResources.Function</th>
                    <th colspan="2">@ViewResources.Permission</th>
                </tr>
                <tr class="level1">
                    <th style="width: 50px">@ViewResources.Read</th>
                    <th style="width: 50px">@ViewResources.Host</th>
                </tr>
            </thead>
            <tbody>
                @if (functionList.Count > 0)
                {
                    var functionCount = functionList.Count;
                    for (int i = 0; i < functionCount; i++)
                    {
                        var function = functionList[i];
                        var groupFuncPolicy = groupFuncPolicyList.Where(x => x.Function.Id == function.Id).SingleOrDefault();
                        var userFuncPolicy = userFuncPolicyList.Where(x => x.Function.Id == function.Id).SingleOrDefault();
                        string parentId = function.Parent != null ? function.Parent.Id.ToString() : string.Empty;

                        var funcNameStyle = i == functionCount - 1 ? "no-border-top" : "no-border-top no-border-bottom";
                        if (function.Parent == null)
                        {
                            funcNameStyle = i == functionCount - 1 ? string.Empty : "no-border-bottom";
                        }

                        string chkReadId = "funcRead" + function.Id;
                        string checkedReadCss = groupFuncPolicy != null && groupFuncPolicy.Policy >= (int)Constant.Policy.Read
                            ? "checked" : string.Empty;
                        bool isReadDisabled = userLevel != (int)Constant.Level.PortalAdmin
                            && (!ViewBag.HasAssignFunctionRight
                            || userFuncPolicy == null || userFuncPolicy.Policy < (int)Constant.Policy.Read
                            || (groupFuncPolicy != null && userFuncPolicy.Policy < groupFuncPolicy.Policy));

                        <tr>
                            <td class="@Html.Raw(funcNameStyle)">
                                @IndentChildFunctions(functionList, function)
                            </td>
                            <td class="text-center">
                                @if (isReadDisabled)
                                {
                                    if (!string.IsNullOrWhiteSpace(checkedReadCss))
                                    {
                                        <input id="@chkReadId" name="funcRead" value="@function.Id" pid="@parentId" type="hidden" />
                                    }
                                    <input disabled type="checkbox" class="checkbox" @Html.Raw(checkedReadCss) />
                                    <label></label>
                                }
                                else
                                {
                                    <input id="@chkReadId" name="funcRead" value="@function.Id" pid="@parentId"
                                            class="checkbox" type="checkbox" @Html.Raw(checkedReadCss) />
                                    <label for="@chkReadId"></label>
                                }
                            </td>
                            <td class="text-center">
                                @if (function.Crud > 0)
                                {
                                    string chkHostId = "funcHost" + function.Id;
                                    string checkedHostCss = groupFuncPolicy != null && groupFuncPolicy.Policy >= (int)Constant.Policy.Host
                                        ? "checked" : string.Empty;
                                    bool isHostDisabled = userLevel != (int)Constant.Level.PortalAdmin
                                        && (!ViewBag.HasAssignFunctionRight
                                        || userFuncPolicy == null || userFuncPolicy.Policy < (int)Constant.Policy.Host
                                        || (groupFuncPolicy != null && userFuncPolicy.Policy < groupFuncPolicy.Policy));

                                    if (isHostDisabled)
                                    {
                                        <input type="checkbox" class="checkbox" @Html.Raw(checkedHostCss) />
                                        <label></label>
                                        if (!string.IsNullOrWhiteSpace(checkedHostCss))
                                        {
                                            <input id="@chkHostId" name="funcHost" value="@function.Id" pid="@parentId" type="hidden" />
                                        }
                                    }
                                    else
                                    {
                                        <input id="@chkHostId" name="funcHost" value="@function.Id" pid="@parentId"
                                                class="checkbox" type="checkbox" @Html.Raw(checkedHostCss) />
                                        <label for="@chkHostId"></label>
                                    }
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center">
                            @ViewResources.NoInformationAvailable
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <input type="hidden" name="GroupId" value="@Model.GroupId" />
        <input type="hidden" name="GroupName" value="@Model.GroupName" />
        <input type="hidden" name="SiteId" value="@Model.SiteId" />
        <input type="hidden" id="HasAssignFunction" value="@ViewBag.HasAssignFunctionRight" />

        <div class="button-list">
            @if (!success)
            {
                <input type="submit" class="btn btn-submit" value="@ViewResources.Save" id="btnSaveAssign" />
                <button class="btn btn-cancel" onclick="NAP.redirect('Group/Manage', 0); return false;">@ViewResources.Cancel</button>
            }
        </div>
    }
</div>
@if (success)
{
    string dialogMsg = string.Format(ViewResources.Your_changes_were_saved);

    <script type="text/javascript">
        var url = '/Group/Manage';
        NAP.showSuccessMsg('@ViewResources.Your_changes_were_saved', url, 3000);
    </script>
}
@helper IndentChildFunctions(List<AccFunction> functionList, AccFunction function, int level = 0)
{
    if (function.Parent != null)
    {
        var parent = functionList.Where(x => x.Id == function.Parent.Id).SingleOrDefault();

        @IndentChildFunctions(functionList, parent, level + 1)
    }
    else
    {
        for (int i = 0; i < level; i++)
        {
            if (i == level - 1)
            {
                <span>&#9492;&#9472;&#9472;</span>
            }
            else
            {
                <span class="invisible">&#9492;&#9472;&#9472;</span>
            }
        }
    }

    if (level == 0)
    {
        @function.Name
    }
}