@using Fanex.Athena.Model.UserManagement.Criteria
@model UpdateGroupCriteria
@{
    /**/
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
    ViewBag.Title = ViewResources.Update_Group;
    bool success = ViewBag.Success != null && ViewBag.Success;
}

@section pagecss {
    <link href="@Url.ContentLink("/Content/Plugin/bootstrap/bootstrap.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Account/reset.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Plugin/tipsy/tipsy-1.0.0.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Account/style.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Account/NewUser.css")" rel="stylesheet" type="text/css" />
}

@section pagejs {
    <script src="@Url.ContentLink("/Scripts/Group/Manage.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Plugin/tipsy/tipsy-1.0.0.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Account/NAP.js")" type="text/javascript"></script>
}


<div class="section-div">
    <div class="buttons-div">
        <span class="title">
            <span class="first">@ViewResources.Group @ViewResources.Management /</span> @ViewBag.Title
        </span>
    </div>

    @using (Html.BeginForm(null, null, FormMethod.Post, new { @role = "form", @class = "form-horizontal col-sm-6 col-md-4 common-form" }))
    {
        @Html.HiddenFor(g => g.GroupId)
        <div class="form-group summary">
            @Html.ValidationSummary()
        </div>
        <div class="form-group required">
            <div class="col-xs-12 col-sm-3 lbl-field">
                @Html.LabelFor(g => g.GroupName)
            </div>
            <div class="col-xs-12 col-sm-8">
                @Html.TextBoxFor(g => g.GroupName, new { @class = "form-control" })
            </div>
        </div>
        <div class="form-group">
            <div class="col-xs-12 col-sm-3 lbl-field">
                @Html.LabelFor(g => g.Description)
            </div>
            <div class="col-xs-12 col-sm-8">
                @Html.TextBoxFor(g => g.Description, new { @class = "form-control" })
            </div>
        </div>
        <div class="form-group">
            <div class="col-xs-12 col-sm-3 lbl-field">
                @Html.LabelFor(g => g.IsActive)
            </div>
            <div class="col-xs-12 col-sm-8 chk-field">
                @Html.CheckBoxFor(g => g.IsActive, new { @class = "chkActive" })
                @Html.LabelFor(g => g.IsActive, ViewResources.Active)
            </div>
        </div>
        <div class="form-group">
            <div class="col-xs-12 col-sm-3 lbl-field">
            </div>
            <div class="col-xs-12 col-sm-8">
                @if (!success)
                {
                    <input type="submit" value="@ViewResources.Save" />
                    <button class="cancel-button" onclick="NAP.redirect('Group/Manage', 0); return false;">@ViewResources.Cancel</button>
                }
            </div>
        </div>
    }
</div>
@if (success)
{
    string dialogMsg = string.Format(ViewResources.EditSuccessMsg, ViewResources.Group + " '" + Model.GroupName + "'", 3);

    <script type="text/javascript">
        $(function () {

            NAP.showSuccessMsg('@dialogMsg', 'Group/Manage', 4000);
        });
    </script>
}
