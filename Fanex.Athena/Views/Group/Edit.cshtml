@using Fanex.Athena.Model.UserManagement.Criteria
@model UpdateGroupCriteria
@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
    ViewBag.Title = ViewResources.Update_Group;
    bool success = ViewBag.Success != null && ViewBag.Success;
}
@section pagecss {
    <link href="@Url.ContentLinkByEnv("/www/css/build/pages/user/edituser.css")" rel="stylesheet" />
}
@section pagejs {
    <script src="@Url.ContentLink("/Scripts/Account/msgbox-0.0.1.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Account/NAP.js")" type="text/javascript"></script>
}
<div class="container-fluid">
    <div class="breadcrumb">
        <a class="level level-link" href="@Url.Action("Manage", "Group", null)">@Menu.ManageGroup</a>
        <i class="icon-arrow"></i>
        <a class="level" href="javascript:;">@ViewResources.Update_Group</a>
    </div>

    @using (Html.BeginForm(null, null, FormMethod.Post, new { @role = "form", @class = "form-horizontal" }))
    {
        @Html.HiddenFor(g => g.GroupId)
        <div class="form-group">
            @Html.ValidationSummary()
        </div>
        <div class="form-group">
            @Html.LabelFor(g => g.GroupName, new { @class = "label-text required" })
            @Html.TextBoxFor(g => g.GroupName, new { @class = "input-text", @autocomplete = "off" })
        </div>
        <div class="form-group">
            @Html.LabelFor(g => g.Description, new { @class = "label-text" })
            @Html.TextBoxFor(g => g.Description, new { @class = "input-text", @autocomplete = "off" })
        </div>
        <div class="form-group">
            <div class="label-text">@ViewResources.Status</div>
            <div class="checkbox-group">
                <input type="checkbox" class="checkbox" name="IsActive" id="IsActive" @(Model.IsActive ? "checked" : string.Empty) value="true" />
                <label for="IsActive">@ViewResources.Active</label>
                <input name="IsActive" type="hidden" value="false" />
            </div>
        </div>
        <div class="form-group">
            @if (!success)
            {
                <input type="submit" class="btn btn-submit" value="@ViewResources.Save" />
                <button class="btn btn-cancel" onclick="NAP.redirect('Group/Manage', 0); return false;">@ViewResources.Cancel</button>
            }
        </div>
    }
</div>
@if (success)
{
    string dialogMsg = string.Format(ViewResources.EditSuccessMsg, ViewResources.Group + " '" + Model.GroupName + "'", 3);

    <script type="text/javascript">
        $(function () {

            NAP.showSuccessMsg('@dialogMsg', 'Group/Manage', 4000);
        });
    </script>
}
