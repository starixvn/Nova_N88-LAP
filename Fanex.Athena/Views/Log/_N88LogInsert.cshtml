@using Fanex.Athena.Model.UserManagement.Model;
@model List<LogData>

@{
    /**/

    Layout = null;
    var listData = (List<LogData>)ViewBag.LogData ?? new List<LogData>();
}

<table class="grid">
    <thead>
        <tr>
            <th>
                @ViewResources.FieldName
            </th>
            <th>
                @ViewResources.Value
            </th>
        </tr>
    </thead>
    <tbody>
        @{
            int i = 0;
            foreach (var item in listData)
            {
                string rowCss = i % 2 == 0 ? string.Empty : "class='alt'";

                <tr @Html.Raw(rowCss)>
                    <td>
                        @item.FieldName
                    </td>
                    <td>
                        @item.NewValue
                    </td>
                </tr>
                i++;
            }
        }
    </tbody>
</table>